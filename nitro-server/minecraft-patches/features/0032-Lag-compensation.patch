+    // Nitro start - Lag compensation
+    private int lagCompensation(int original, net.minecraft.server.level.ServerLevel level) {
+        if (!gr1mly4memes.nitro.NitroConfig.lagCompensationEnabled || !gr1mly4memes.nitro.NitroConfig.eatingAcceleration || original == 0) return original;
+        return gr1mly4memes.nitro.util.tps.TPSUtil.tt20(original, true, level);
+    }
+    // Nitro end - Lag compensation
 
     public int getUseDuration(ItemStack stack, LivingEntity entity) {
         Consumable consumable = stack.get(DataComponents.CONSUMABLE);
         if (consumable != null) {
-            return consumable.consumeTicks();
+            // Nitro start - Lag compensation
+            int original = consumable.consumeTicks();
+            if (entity.level() instanceof net.minecraft.server.level.ServerLevel serverLevel) {
+                return lagCompensation(original, serverLevel);
+            }
+            return original;
+            // Nitro end - Lag compensation
         } else {
             return !stack.has(DataComponents.BLOCKS_ATTACKS) && !stack.has(DataComponents.KINETIC_WEAPON) ? 0 : 72000;
         }
