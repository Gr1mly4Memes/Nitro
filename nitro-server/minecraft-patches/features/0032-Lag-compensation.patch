@@ -145,9 +145,22 @@ public class ItemEntity extends Entity implements TraceableEntity {
         }
     }
     // Paper end - EAR 2
+    // Nitro start - Lag compensation
+    private void lagCompensation() {
+        if (!gr1mly4memes.nitro.NitroConfig.lagCompensationEnabled || !gr1mly4memes.nitro.NitroConfig.pickupAcceleration) return;
+        if ((this).level().isClientSide()) return;
+        if (pickupDelay == 0) return;
+        if (pickupDelay - ((ServerLevel) this.level()).tpsCalculator.applicableMissedTicks() <= 0) {
+            pickupDelay = 0;
+            return;
+        }
+        pickupDelay = pickupDelay - ((ServerLevel) this.level()).tpsCalculator.applicableMissedTicks();
+    }
+    // Nitro end - Lag compensation
 
     @Override
     public void tick() {
+        lagCompensation(); // Nitro - Lag compensation
         if (this.getItem().isEmpty()) {
             this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DESPAWN); // CraftBukkit - add Bukkit remove cause
         } else {
